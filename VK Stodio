<!doctype html>
<html lang="hi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>VK Studio</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#0b0c14;color:#f7f5ff;font:15px system-ui,Arial}button,input,textarea,select{font:inherit}button{cursor:pointer}.app{display:flex;min-height:100vh}.side{width:225px;background:#11121c;border-right:1px solid #303247;padding:16px 12px}.brand{font-size:22px;font-weight:800;color:#b9a5ff;padding:10px}.nav button{display:block;width:100%;text-align:left;margin:7px 0;padding:12px;border:1px solid #303247;border-radius:11px;background:#191a28;color:white}.nav button:hover{background:#30234c}.main{flex:1;min-width:0}.top{padding:17px 22px;border-bottom:1px solid #303247}.content{max-width:900px;margin:auto;padding:20px}.hero{text-align:center;padding:22px 5px}.hero h1{font-size:clamp(26px,4vw,38px);margin:6px}.muted{color:#a9abc0}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.tile,.panel{background:#171927;border:1px solid #303247;border-radius:16px;padding:17px}.tile{color:white;text-align:left;cursor:pointer}.tile h3{margin:8px 0 4px}.tile p{margin:0;color:#a9abc0;font-size:13px}.panel{margin:15px 0}.field{margin:12px 0}.field label{display:block;color:#b7b8ca;margin-bottom:6px;font-size:13px}.field input,.field textarea,.field select{width:100%;background:#0d0f19;color:white;border:1px solid #3a3d55;border-radius:10px;padding:12px}.field textarea{min-height:105px}.row{display:flex;gap:10px}.row>*{flex:1}.btn{background:linear-gradient(120deg,#8b5cf6,#6d28d9);border:0;border-radius:10px;color:white;padding:12px 16px;font-weight:700}.out{white-space:pre-wrap;background:#0d0f19;border:1px solid #303247;border-radius:10px;padding:14px;margin-top:12px;line-height:1.5}.hidden{display:none!important}.ad{border:1px dashed #57516a;color:#aaa2bd;text-align:center;padding:14px;border-radius:10px;margin:17px 0;font-size:12px}.msg{padding:11px;border-radius:10px;margin:8px 0;white-space:pre-wrap}.user{background:#3a2a59}.bot{background:#222538}.chatrow{display:flex;gap:8px}.chatrow textarea{flex:1;background:#0d0f19;color:white;border:1px solid #3a3d55;border-radius:10px;padding:12px}.foot{text-align:center;color:#777b91;font-size:12px;padding:25px}@media(max-width:650px){.side{width:65px;padding:10px 5px}.brand{font-size:0;padding:8px}.brand:after{content:"VK";font-size:18px}.nav button{font-size:0;text-align:center;padding:13px 2px}.nav button:first-letter{font-size:17px}.content{padding:13px}.row{display:block}}
</style></head><body><div class="app"><aside class="side"><div class="brand">VK Studio</div><nav class="nav"><button onclick="page('home')">🏠 Home</button><button onclick="page('chat')">💬 AI Chat</button><button onclick="page('story')">📖 Story Generator</button><button onclick="page('video')">🎬 Video Prompt</button><button onclick="page('image')">🖼️ Image Prompt</button><button onclick="page('seo')">📺 YouTube SEO</button></nav></aside><main class="main"><header class="top"><b id="title">VK Studio — AI Creator Tools</b></header><div class="content">
<section id="home"><div class="hero"><h1>नमस्ते! VK Studio में स्वागत है ✨</h1><p class="muted">कहानी, वीडियो प्रॉम्प्ट, इमेज प्रॉम्प्ट और YouTube SEO — एक ही जगह।</p></div><div class="grid">
<button class="tile" onclick="page('chat')"><h3>💬 AI Chat</h3><p>डेमो चैट इंटरफेस</p></button><button class="tile" onclick="page('story')"><h3>📖 Story Generator</h3><p>कहानी का ड्राफ्ट बनाएँ</p></button><button class="tile" onclick="page('video')"><h3>🎬 Video Prompt</h3><p>5 या 10 सेकंड वीडियो के प्रॉम्प्ट</p></button><button class="tile" onclick="page('image')"><h3>🖼️ Image Prompt</h3><p>AI इमेज के लिए प्रॉम्प्ट</p></button><button class="tile" onclick="page('seo')"><h3>📺 YouTube SEO</h3><p>टाइटल, डिस्क्रिप्शन और टैग</p></button></div><div class="ad">ADVERTISEMENT SPACE — Ad network approval/code required</div><p class="muted">नोट: ये बिना API के टेक्स्ट ड्राफ्ट बनाने वाले टूल हैं। असली AI चैट और वीडियो जनरेशन के लिए बाद में सुरक्षित API/backend जोड़ना होगा।</p></section>
<section id="chat" class="hidden"><div class="hero"><h1>💬 AI Chat</h1><p class="muted">अभी डेमो मोड — असली AI API अभी कनेक्ट नहीं है।</p></div><div class="panel"><div id="log"><div class="msg bot">नमस्ते! VK Studio में आपका स्वागत है।</div></div><div class="chatrow"><textarea id="chatInput" placeholder="अपना सवाल लिखें..."></textarea><button class="btn" onclick="chat()">➤</button></div></div></section>
<section id="story" class="hidden"><div class="hero"><h1>📖 Story Generator</h1></div><div class="panel"><div class="field"><label>कहानी का विषय</label><input id="topic" placeholder="गरीब लड़के की मेहनत और सफलता"></div><div class="row"><div class="field"><label>शैली</label><select id="stype"><option>Emotional</option><option>Motivational</option><option>Comedy</option><option>Devotional</option><option>Adventure</option></select></div><div class="field"><label>लंबाई</label><select id="slen"><option>Short</option><option>Medium</option><option>Long</option></select></div></div><button class="btn" onclick="story()">✨ कहानी बनाएँ</button><div id="sout" class="out hidden"></div><button class="btn" onclick="copy('sout')">कॉपी करें</button></div></section>
<section id="video" class="hidden"><div class="hero"><h1>🎬 Video Prompt Generator</h1></div><div class="panel"><div class="field"><label>वीडियो में क्या दिखाना है?</label><textarea id="videa" placeholder="हनुमान जी पहाड़ पर बैठकर श्रीराम की मूर्ति बना रहे हैं..."></textarea></div><div class="row"><div class="field"><label>Duration</label><select id="vdur"><option>5 seconds</option><option selected>10 seconds</option></select></div><div class="field"><label>Format</label><select id="vformat"><option>9:16 Vertical Shorts</option><option>16:9 YouTube</option><option>1:1 Square</option></select></div></div><button class="btn" onclick="videoPrompt()">✨ Prompt बनाएँ</button><div id="vout" class="out hidden"></div><button class="btn" onclick="copy('vout')">कॉपी करें</button></div></section>
<section id="image" class="hidden"><div class="hero"><h1>🖼️ Image Prompt Generator</h1></div><div class="panel"><div class="field"><label>इमेज का आइडिया</label><textarea id="iidea" placeholder="पहाड़ों के बीच सूर्यास्त में मंदिर..."></textarea></div><div class="row"><div class="field"><label>Style</label><select id="istyle"><option>Photorealistic</option><option>3D Animation</option><option>Digital Art</option><option>Cinematic</option><option>Watercolor</option></select></div><div class="field"><label>Ratio</label><select id="iratio"><option>16:9</option><option>9:16</option><option>1:1</option></select></div></div><button class="btn" onclick="imagePrompt()">✨ Image Prompt बनाएँ</button><div id="iout" class="out hidden"></div><button class="btn" onclick="copy('iout')">कॉपी करें</button></div></section>
<section id="seo" class="hidden"><div class="hero"><h1>📺 YouTube SEO Helper</h1></div><div class="panel"><div class="field"><label>वीडियो का विषय</label><input id="ytopic" placeholder="हनुमान जी की भक्ति कथा"></div><div class="field"><label>मुख्य कीवर्ड (वैकल्पिक)</label><input id="ykey" placeholder="Hanuman bhakti"></div><button class="btn" onclick="seo()">✨ SEO ड्राफ्ट बनाएँ</button><div id="yout" class="out hidden"></div><button class="btn" onclick="copy('yout')">कॉपी करें</button></div></section>
<div class="ad">ADVERTISEMENT SPACE — AdSense approval/code required</div><div class="foot">© 2026 VK Studio</div></div></main></div>
<script>
const ids=['home','chat','story','video','image','seo'],titles={home:'VK Studio — AI Creator Tools',chat:'AI Chat',story:'Story Generator',video:'Video Prompt Generator',image:'Image Prompt Generator',seo:'YouTube SEO'};
function page(p){ids.forEach(x=>document.getElementById(x).classList.toggle('hidden',x!==p));document.getElementById('title').textContent=titles[p]}
function output(id,t){let e=document.getElementById(id);e.textContent=t;e.classList.remove('hidden')}
function story(){let t=document.getElementById('topic').value.trim();if(!t)return alert('कहानी का विषय लिखें');output('sout',`शीर्षक: ${t}\nशैली: ${document.getElementById('stype').value}\n\nएक छोटे से गाँव में एक इंसान रहता था जिसके मन में ${t} का सपना था। रास्ता आसान नहीं था। कई मुश्किलें आईं, लेकिन उसने हिम्मत नहीं छोड़ी। हर दिन की मेहनत और विश्वास ने उसे आगे बढ़ाया। अंत में उसने सीखा कि सच्ची सफलता धैर्य, मेहनत और अच्छे इरादों से मिलती है।\n\nयह शुरुआती ड्राफ्ट है; इसमें अपने पात्र, संवाद और दृश्य जोड़कर कहानी को विस्तार दें। लंबाई: ${document.getElementById('slen').value}`)}
function videoPrompt(){let t=document.getElementById('videa').value.trim();if(!t)return alert('वीडियो का आइडिया लिखें');output('vout',`VIDEO PROMPT\n${t}\n\nDuration: ${document.getElementById('vdur').value}\nAspect ratio: ${document.getElementById('vformat').value}\nStyle: cinematic, highly detailed, realistic motion\nCamera: smooth controlled camera movement\nLighting: cinematic natural lighting\nQuality: high detail, stable frames, coherent motion\nNegative prompt: blurry, distortion, flicker, watermark, unwanted text.`)}
function imagePrompt(){let t=document.getElementById('iidea').value.trim();if(!t)return alert('इमेज का आइडिया लिखें');output('iout',`IMAGE PROMPT\n${t}\n\nStyle: ${document.getElementById('istyle').value}\nAspect ratio: ${document.getElementById('iratio').value}\nComposition: clear subject, balanced framing, detailed background\nLighting: cinematic lighting, natural shadows\nQuality: sharp focus, highly detailed, professional composition\nAvoid: blur, distorted anatomy, watermark, unwanted text.`)}
function seo(){let t=document.getElementById('ytopic').value.trim();if(!t)return alert('वीडियो का विषय लिखें');let k=document.getElementById('ykey').value.trim()||t;output('yout',`TITLE IDEAS\n1. ${t} | दिल छू लेने वाला वीडियो ❤️\n2. ${t} की अद्भुत कहानी | जरूर देखें\n3. ${t} का सुंदर दृश्य 🙏\n\nDESCRIPTION\nआज के वीडियो में देखिए: ${t}\nवीडियो पसंद आए तो Like, Share और Subscribe करें।\n\nTAGS\n${k}, ${t}, Hindi video, trending, entertainment\n\nHASHTAGS\n#Hindi #Trending #Viral`)}
function chat(){let t=document.getElementById('chatInput').value.trim();if(!t)return;let l=document.getElementById('log');let u=document.createElement('div');u.className='msg user';u.textContent=t;l.appendChild(u);let b=document.createElement('div');b.className='msg bot';b.textContent='यह डेमो चैट है। असली AI जवाब पाने के लिए बाद में सुरक्षित AI API कनेक्ट करनी होगी।';l.appendChild(b);document.getElementById('chatInput').value=''}
function copy(id){let t=document.getElementById(id).textContent;if(!t)return;navigator.clipboard?.writeText(t).then(()=>alert('कॉपी हो गया!')).catch(()=>alert('टेक्स्ट को देर तक दबाकर कॉपी करें।'))}
</script></body></html>
